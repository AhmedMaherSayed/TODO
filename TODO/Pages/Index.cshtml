@page
@model TODO.Pages.IndexModel
@{
    ViewData["Title"] = "Todo List";
    var isEditing = Model.Input?.Id.HasValue == true;
}

<div class="mb-4">
    <h1 class="mb-3">Todo List</h1>
    <p class="text-muted mb-0">Add tasks, mark them complete, edit, or delete. Data is stored in SQL Server via EF Core.</p>
</div>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form method="post" asp-page-handler="Save" novalidate>
            <input asp-for="Input.Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Input.Title" class="form-label"></label>
                <input asp-for="Input.Title" class="form-control" placeholder="e.g. Buy groceries" />
                <span asp-validation-for="Input.Title" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Notes" class="form-label"></label>
                <textarea asp-for="Input.Notes" class="form-control" rows="2" placeholder="Optional details"></textarea>
                <span asp-validation-for="Input.Notes" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">@(isEditing ? "Save changes" : "Add task")</button>
                @if (isEditing)
                {
                    <a asp-page="./Index" class="btn btn-secondary">Cancel edit</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex align-items-center mb-3">
            <h2 class="h5 mb-0">Your tasks</h2>
            <span class="badge bg-secondary ms-2" id="todo-count">@Model.Todos.Count</span>
        </div>
        @if (Model.Todos.Any())
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0" aria-label="Todo items">
                    <thead>
                        <tr>
                            <th scope="col" style="width: 70px;">Done</th>
                            <th scope="col">Title</th>
                            <th scope="col">Notes</th>
                            <th scope="col" class="text-end" style="width: 200px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var todo in Model.Todos)
                        {
                            <tr class="@(todo.IsCompleted ? "table-light" : string.Empty)">
                                <td>
                                    <form method="post" asp-page-handler="Toggle" class="d-inline">
                                        <input type="hidden" name="id" value="@todo.Id" />
                                        <input class="form-check-input" type="checkbox" aria-label="Toggle @todo.Title" onchange="this.form.submit();" @(todo.IsCompleted ? "checked" : string.Empty) />
                                    </form>
                                </td>
                                <td>
                                    <span class="@(todo.IsCompleted ? "text-decoration-line-through text-muted" : string.Empty)">@todo.Title</span>
                                </td>
                                <td class="@(todo.IsCompleted ? "text-muted" : string.Empty)">@todo.Notes</td>
                                <td class="text-end">
                                    <a asp-page="./Index" asp-route-editId="@todo.Id" class="btn btn-sm btn-outline-secondary me-2">Edit</a>
                                    <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('Delete this task?');">
                                        <input type="hidden" name="id" value="@todo.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted mb-0">No tasks yet. Add one above to get started.</p>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
